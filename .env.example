# Copy to `.env` and fill in your own values.
#
# This file is a template and is meant to be shared: it must never contain a
# real credential. `.env` is gitignored and is where real values belong.
#
# ---------------------------------------------------------------------------
# Meta Model API (Muse inference and research)
# ---------------------------------------------------------------------------
# Used for BOTH Muse inference and Muse web-search research (the Responses
# API's web_search tool is billed separately but needs no second credential).
# Either name configures the same key; MUSE_API_KEY wins when both are set.
# MODEL_API_KEY is Meta's official name for this key.
MUSE_API_KEY=your-meta-model-api-key
MUSE_BASE_URL=https://api.meta.ai/v1/

# ---------------------------------------------------------------------------
# Muse model routing
# ---------------------------------------------------------------------------
# Model IDs are NEVER hardcoded in application code -- they are read from here.
#
# Run `make check` to validate whatever you set here against the live
# /v1/models catalog before relying on it.
MODEL_NANO=muse-spark-1.1
MODEL_SUPER=muse-spark-1.2
MODEL_ULTRA=muse-spark-1.3

# Optional. Per-model prices in USD per 1M tokens, keyed by model ID. Used only
# to estimate call cost; when a model is absent here, cost is reported as
# unknown rather than guessed.
#   MODEL_PRICING={"muse-spark-1.2":{"input":0.05,"output":0.20}}
MODEL_PRICING=

# Hard timeout for a single model call, in seconds.
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Local infrastructure (docker compose up)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://repolens:repolens@localhost:5432/repolens
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml) -- see docs/DEPLOY_GCP.md
# ---------------------------------------------------------------------------
# Leave these commented out for local development.
#
# On the VM, `.env` holds real secrets: `chmod 600 .env`, and never commit it.
# docker-compose.prod.yml builds DATABASE_URL and REDIS_URL itself from the two
# passwords below, so the local-infrastructure values above are ignored there.
#
# The domain name, or the VM's public IP until DNS exists.
# REPOLENS_DOMAIN=<DOMAIN>
#
# The URL people open: http://<VM_PUBLIC_IP> at first, https://<DOMAIN> after
# scripts/deploy/init_tls.sh. The browser calls the API at PUBLIC_URL/api.
# This is the ONLY value that reaches the browser (as NEXT_PUBLIC_API_URL, set
# at image build time). Never put a credential in any NEXT_PUBLIC_* variable,
# and leave NEXT_PUBLIC_REPOLENS_DEBUG unset in production.
# PUBLIC_URL=http://<VM_PUBLIC_IP>
#
# Generate each with: openssl rand -hex 32   (hex keeps them URL-safe)
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
#
# For Let's Encrypt expiry notices.
# LETSENCRYPT_EMAIL=<EMAIL>
#
# Live web apps are served at <scheme>://rt-<runtime>-<service>.<domain>. They
# need a wildcard DNS record (*.<DOMAIN>) and, for https, a wildcard certificate.
# RUNTIME_PROXY_DOMAIN=<DOMAIN>
# RUNTIME_PROXY_SCHEME=https
# RUNTIME_PROXY_ORIGIN_PORT=443
#
# Browser origins allowed to call the API cross-origin, as a JSON list. Behind
# nginx the web app and API share one origin, so the default is enough.
# CORS_ORIGINS=["https://<DOMAIN>"]
